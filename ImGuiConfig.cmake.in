@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/ImGuiTargets.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/ImGuiTargets.cmake")
endif()

if(TARGET ImGui::Impl_Allegro5)
  find_dependency(Allegro)
endif()

if(TARGET ImGui::Impl_GLFW)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Emscripten")
    find_dependency(glfw3)
  endif()
endif()

if(TARGET ImGui::Impl_GLUT)
  find_dependency(FreeGLUT)
endif()

if(TARGET ImGui::Impl_SDL2)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Emscripten")
    find_dependency(SDL2)
  endif()
endif()

if(TARGET ImGui::Impl_SDLRenderer2)
  find_dependency(SDL2)
endif()

if(TARGET ImGui::Impl_SDL3)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Emscripten")
    find_dependency(SDL3)
  endif()
endif()

if(TARGET ImGui::Impl_SDLRenderer3)
  find_dependency(SDL3)
endif()

if(TARGET ImGui::Impl_SDLGPU3)
  find_dependency(SDL3)
endif()

if(TARGET ImGui::Impl_OpenGL2)
  find_dependency(OpenGL 2)
endif()

if(TARGET ImGui::Impl_OpenGL3)
  if(CMAKE_SYSTEM_NAME STREQUAL "Android")
    find_dependency(OpenGL 3 COMPONENTS EGL GLES2 GLES3)
  else()
    find_dependency(OpenGL 3)
  endif()
endif()

if(TARGET ImGui::Impl_Vulkan)
  find_dependency(Vulkan)
endif()

if(TARGET ImGui::Impl_WebGPU)
  if(@IMGUI_IMPL_WEBGPU_BACKEND_DAWN@)
    find_dependency(Dawn)
  endif()
endif()

if(@IMGUI_ENABLE_FREETYPE@)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Emscripten")
    find_dependency(Freetype NAMES Freetype freetype)
  endif()
endif()
