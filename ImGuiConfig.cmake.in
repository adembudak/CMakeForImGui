@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/ImGuiTargets.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/ImGuiTargets.cmake")
endif()

if(TARGET ImGui::imgui_impl_sdlgpu3 AND NOT TARGET ImGui::Backend_SDLGPU3)
  add_library(ImGui::Backend_SDLGPU3 ALIAS ImGui::imgui_impl_sdlgpu3)
endif()

if(TARGET ImGui::imgui_impl_osx AND NOT TARGET ImGui::Backend_OSX)
  add_library(ImGui::Backend_OSX ALIAS ImGui::imgui_impl_osx)
endif()

if(TARGET ImGui::imgui_impl_metal AND NOT TARGET ImGui::Backend_Metal)
  add_library(ImGui::Backend_Metal ALIAS ImGui::imgui_impl_metal)
endif()

if(${CMAKE_FIND_PACKAGE_NAME}_FIND_REQUIRED)
  set(required REQUIRED)
endif()

if(${CMAKE_FIND_PACKAGE_NAME}_FIND_QUIETLY)
  set(quiet QUIET)
endif()

if(TARGET ImGui::Impl_Allegro5)
  find_dependency(Allegro ${quiet} ${required})
endif()

if(TARGET ImGui::Impl_GLFW)
  find_dependency(glfw3 ${quiet} ${required})
endif()

if(TARGET ImGui::Impl_GLUT)
  find_dependency(FreeGLUT ${quiet} ${required})
endif()

if(TARGET ImGui::Impl_SDL2)
  find_dependency(SDL2 ${quiet} ${required})
endif()

if(TARGET ImGui::Impl_SDLRenderer2)
  find_dependency(SDL2 ${quiet} ${required})
endif()

if(TARGET ImGui::Impl_SDL3)
  find_dependency(SDL3 ${quiet} ${required})
endif()

if(TARGET ImGui::Impl_SDLRenderer3)
  find_dependency(SDL3 ${quiet} ${required})
endif()

if(TARGET ImGui::Backend_SDLGPU3)
  find_dependency(SDL3 ${quiet} ${required})
endif()

if(TARGET ImGui::Impl_OpenGL2)
  find_dependency(OpenGL 2 ${quiet} ${required})
endif()

if(TARGET ImGui::Impl_OpenGL3)
  find_dependency(OpenGL 3 ${quiet} ${required})
endif()

if(TARGET ImGui::Impl_Vulkan)
  find_dependency(Vulkan ${quiet} ${required})
endif()

if(TARGET ImGui::Impl_WebGPU)
  find_dependency(Threads ${quiet} ${required})
  find_dependency(Dawn ${quiet} ${required})
endif()


if(@IMGUI_ENABLE_FREETYPE@)
  find_dependency(freetype ${quiet} ${required})

  if(@IMGUI_ENABLE_FREETYPE_LUNASVG@)
    find_dependency(lunasvg ${quiet} ${required})
  elseif(@IMGUI_ENABLE_FREETYPE_PLUTOSVG@)
    find_dependency(plutosvg ${quiet} ${required})
  endif()
endif()
